{
  "openapi": "3.0.3",
  "info": {
    "title": "URL Shortener API",
    "version": "2.0.0",
    "description": "RESTful API documentation for the URL Shortener microservice built with the GoFr framework. Supports user management, API keys, custom branded domains, link expiry, and redirection."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Application health monitoring and service status"
    },
    {
      "name": "Users",
      "description": "User registration, authentication, and profile management"
    },
    {
      "name": "API Keys",
      "description": "Developer API key generation, listing, and revocation"
    },
    {
      "name": "URLs",
      "description": "URL shortening, listing, detail retrieval, updating, and deletion"
    },
    {
      "name": "Analytics",
      "description": "Detailed click statistics, device breakdowns, and timeseries reporting"
    },
    {
      "name": "Redirection",
      "description": "Public and owner-protected URL redirection"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health Check",
        "description": "Returns the health status of the application and its connected datasources (e.g. MongoDB).",
        "responses": {
          "200": {
            "description": "Application is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/users/register": {
      "post": {
        "tags": ["Users"],
        "summary": "Register a New User",
        "description": "Registers a new user account with username, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/users/login": {
      "post": {
        "tags": ["Users"],
        "summary": "User Login",
        "description": "Authenticates a user using email or username and password, returning a JWT token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users/profile": {
      "get": {
        "tags": ["Users"],
        "summary": "Get User Profile",
        "description": "Retrieves profile information for the currently authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update User Profile",
        "description": "Updates profile information (username, email, password) for the authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users/api-key": {
      "post": {
        "tags": ["API Keys"],
        "summary": "Generate API Key",
        "description": "Generates a new API key for developer access.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "responses": {
          "201": {
            "description": "API key generated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/APIKeyResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users/api-keys": {
      "get": {
        "tags": ["API Keys"],
        "summary": "List API Keys",
        "description": "Lists all active API keys associated with the authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "List of active API keys",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/APIKeysResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users/api-keys/{api_key}": {
      "delete": {
        "tags": ["API Keys"],
        "summary": "Revoke API Key",
        "description": "Revokes an existing API key for the authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "api_key",
            "in": "path",
            "required": true,
            "description": "The API key string to revoke",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": { "type": "string", "example": "API key revoked successfully" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/urls": {
      "post": {
        "tags": ["URLs"],
        "summary": "Create Short URL",
        "description": "Creates a short URL for the provided target URL. Supports custom short codes, custom branded domains, public/private visibility, and expiry timestamps.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUrlRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Short URL created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UrlResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "get": {
        "tags": ["URLs"],
        "summary": "List User URLs",
        "description": "Lists URLs owned by the authenticated user with pagination and sorting options.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "(Optional) Page number (default: 1)",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "(Optional) Items per page (default: 10, max: 100)",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "(Optional) Sort field: created_at, short_code, or total_clicks (default: created_at)",
            "schema": { "type": "string", "default": "created_at" }
          },
          {
            "name": "order",
            "in": "query",
            "description": "(Optional) Sort direction: asc or desc (default: desc)",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of owned URLs",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UrlListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/urls/{short_code}": {
      "get": {
        "tags": ["URLs"],
        "summary": "Get URL Details",
        "description": "Retrieves details for a specific URL owned by the authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "The unique short code identifier",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "URL details retrieved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UrlResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["URLs"],
        "summary": "Update URL",
        "description": "Updates settings for an owned URL, such as target URL, public visibility, custom domain, or expiration date.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "The unique short code identifier",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUrlRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "URL updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UrlResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["URLs"],
        "summary": "Delete URL",
        "description": "Deletes a URL owned by the authenticated user.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "The unique short code identifier",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "URL deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": { "type": "string", "example": "URL deleted successfully" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/urls/{short_code}/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Get URL Analytics Summary",
        "description": "Retrieves comprehensive click summary analytics for an owned URL, including total clicks, unique clicks, and breakdowns by Browser, OS, Device Type, Country, and Top Referrers.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "Short code identifier",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Analytics summary retrieved successfully"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/urls/{short_code}/analytics/timeseries": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Get URL Analytics Timeseries",
        "description": "Retrieves click volume aggregated over time (by hour or day) for an owned URL.",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "Short code identifier",
            "schema": { "type": "string" }
          },
          {
            "name": "unit",
            "in": "query",
            "required": false,
            "description": "Aggregation unit: 'hour' or 'day' (default: 'day')",
            "schema": { "type": "string", "default": "day" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of timeseries points (default: 30)",
            "schema": { "type": "integer", "default": 30 }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeseries analytics retrieved successfully"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/{short_code}": {
      "get": {
        "tags": ["Redirection"],
        "summary": "Redirect to Original URL",
        "description": "Redirects callers to the destination target URL. Public URLs redirect without authentication; private URLs require owner Bearer token.",
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "description": "The unique short code identifier",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirecting to original URL",
            "headers": {
              "Location": {
                "description": "Destination original URL",
                "schema": { "type": "string", "format": "uri" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supply standard JWT Authorization header: Bearer <jwt_token>"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Supply developer API key: X-API-Key: usk_..."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input request parameters or payload",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid Bearer authentication token or API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded (100 requests per minute)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict (e.g. custom short code already in use or user already exists)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource not found or link expired",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "UP" },
              "details": {
                "type": "object",
                "properties": {
                  "mongoDB": { "type": "string", "example": "UP" }
                }
              }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "example": "testuser", "description": "(Required) Unique username" },
          "email": { "type": "string", "format": "email", "example": "test@example.com", "description": "(Required) User email address" },
          "password": { "type": "string", "format": "password", "example": "password123", "description": "(Required) Account password" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "test@example.com", "description": "(Required) User email or username" },
          "password": { "type": "string", "format": "password", "example": "password123", "description": "(Required) User account password" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "description": "All fields are optional; supply only fields to update.",
        "properties": {
          "username": { "type": "string", "example": "new-username", "description": "(Optional) Updated username" },
          "email": { "type": "string", "format": "email", "example": "new@example.com", "description": "(Optional) Updated email address" },
          "password": { "type": "string", "format": "password", "example": "newpassword123", "description": "(Optional) Updated password" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "607f1f77bcf86cd799439011" },
          "username": { "type": "string", "example": "testuser" },
          "email": { "type": "string", "format": "email", "example": "test@example.com" },
          "api_keys": {
            "type": "array",
            "items": { "type": "string" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        }
      },
      "APIKeyResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "api_key": { "type": "string", "example": "usk_abc123xyz..." }
            }
          }
        }
      },
      "APIKeysResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "api_keys": {
                "type": "array",
                "items": { "type": "string", "example": "usk_abc123xyz..." }
              }
            }
          }
        }
      },
      "CreateUrlRequest": {
        "type": "object",
        "required": ["original_url"],
        "properties": {
          "original_url": { "type": "string", "format": "uri", "example": "https://gofr.dev", "description": "(Required) Target destination URL to shorten" },
          "custom_code": { "type": "string", "example": "my-code", "description": "(Optional) Custom short code alias (3-64 chars)" },
          "public": { "type": "boolean", "default": false, "example": true, "description": "(Optional) Link visibility (true: public redirect without auth, false: requires owner auth)" },
          "custom_domain": { "type": "string", "example": "sksm.tech", "description": "(Optional) Custom branded domain for short URL" },
          "expires_at": { "type": "string", "format": "date-time", "example": "2028-12-31T23:59:59Z", "description": "(Optional) UTC expiration date-time" }
        }
      },
      "UpdateUrlRequest": {
        "type": "object",
        "description": "All fields are optional; supply only fields to update.",
        "properties": {
          "original_url": { "type": "string", "format": "uri", "example": "https://gofr.dev/docs", "description": "(Optional) New destination target URL" },
          "public": { "type": "boolean", "example": true, "description": "(Optional) Change public/private visibility" },
          "custom_domain": { "type": "string", "example": "links.mysite.com", "description": "(Optional) Update custom branded domain" },
          "clear_custom_domain": { "type": "boolean", "default": false, "example": false, "description": "(Optional) Set true to remove custom domain and revert to default host" },
          "expires_at": { "type": "string", "format": "date-time", "example": "2028-12-31T23:59:59Z", "description": "(Optional) Update UTC expiration timestamp" },
          "clear_expiry": { "type": "boolean", "default": false, "example": false, "description": "(Optional) Set true to remove link expiration date" }
        }
      },
      "UrlResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Url" }
        }
      },
      "UrlListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Url" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Url": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "607f1f77bcf86cd799439011" },
          "original_url": { "type": "string", "format": "uri", "example": "https://gofr.dev" },
          "short_code": { "type": "string", "example": "my-code" },
          "user_id": { "type": "string", "example": "607f1f77bcf86cd799439012" },
          "public": { "type": "boolean", "example": true },
          "custom_domain": { "type": "string", "example": "sksm.tech" },
          "expires_at": { "type": "string", "format": "date-time", "example": "2028-12-31T23:59:59Z" },
          "total_clicks": { "type": "integer", "format": "int64", "example": 42 },
          "unique_clicks": { "type": "integer", "format": "int64", "example": 35 },
          "short_url": { "type": "string", "format": "uri", "example": "https://sksm.tech/my-code" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "format": "int64", "example": 1 },
          "total_pages": { "type": "integer", "example": 1 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string", "example": "invalid URL or authorization failure" }
            }
          }
        }
      }
    }
  }
}
